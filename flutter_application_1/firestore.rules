rules_version = '2';

// Die App hat einen Login, und jede Person hat ihre eigene, private Datenbank (Bands, Musiker, ...) statt einer gemeinsamen für alle.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Bands, Musiker, Alben, Songs, Genres und Rollen: nur die Person, der sie gehören, darf sie sehen und ändern.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
