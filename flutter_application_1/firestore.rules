rules_version = '2';

// Entwicklungs-Regeln fuer MusicDB.
// Die App hat aktuell keinen Login, daher sind Lesen und Schreiben ohne
// Authentifizierung erlaubt. Sobald es eine Anmeldung gibt, sollte das
// hier auf "request.auth != null" eingeschraenkt werden.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
